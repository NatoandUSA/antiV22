{
  "manifest_version": 3,
  "name": "22Etsy Pattern Evidence Harvester",
  "version": "3.6.3",
  "description": "Capture Etsy/HeyEtsy pattern evidence, listing details, visible review language, and review summary graphs to 22etsy /api/import.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://trends.ytuong.ai/*",
    "https://ytuong.me/*",
    "https://heyetsy.com/*",
    "https://www.etsy.com/*",
    "https://*.etsystatic.com/*",
    "https://www.pinterest.com/*",
    "https://*.pinterest.com/*",
    "https://www.amazon.com/*",
    "https://www.alibaba.com/*",
    "https://*.alibaba.com/*",
    "https://www.aliexpress.com/*",
    "https://*.aliexpress.com/*",
    "https://*.aliexpress.us/*",
    "https://www.1688.com/*",
    "https://*.1688.com/*",
    "https://etsy.theglobalserviceteam.site/*"
  ],
  "action": {
    "default_title": "22Etsy Pattern Evidence Harvester settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://trends.ytuong.ai/*",
        "https://ytuong.me/*",
        "https://heyetsy.com/*",
        "https://www.etsy.com/*",
        "https://www.pinterest.com/*",
        "https://*.pinterest.com/*",
        "https://www.amazon.com/*",
        "https://www.alibaba.com/*",
        "https://*.alibaba.com/*",
        "https://www.aliexpress.com/*",
        "https://*.aliexpress.com/*",
        "https://*.aliexpress.us/*",
        "https://www.1688.com/*",
        "https://*.1688.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}