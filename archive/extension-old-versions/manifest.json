{
  "manifest_version": 3,
  "name": "YTrends Exporter (for 22etsy-agent)",
  "version": "1.1.0",
  "description": "One-click CSV export of any YTrends data table (Hidden Gems, Trending, Categories, Newest...) - and optional push to your local 22etsy-agent. Reads only the table you're viewing; no marketplace automation.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://trends.ytuong.ai/*",
    "https://ytuong.me/*",
    "https://heyetsy.com/*"
  ],
  "action": {
    "default_title": "YTrends Exporter settings",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [
    {
      "matches": [
        "https://trends.ytuong.ai/*",
        "https://ytuong.me/*",
        "https://heyetsy.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
