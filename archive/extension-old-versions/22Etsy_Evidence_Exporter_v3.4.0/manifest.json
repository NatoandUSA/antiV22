{
  "manifest_version": 3,
  "name": "22Etsy Evidence Exporter",
  "version": "3.4.0",
  "description": "Capture listing, market, and Etsy review evidence as CSV/JSON or send it to 22etsy /api/import. Rendered data only; no invented values or marketplace writes.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://trends.ytuong.ai/*",
    "https://ytuong.me/*",
    "https://heyetsy.com/*",
    "https://www.etsy.com/*",
    "https://*.etsystatic.com/*",
    "https://www.pinterest.com/*",
    "https://*.pinterest.com/*",
    "https://www.amazon.com/*",
    "https://www.alibaba.com/*",
    "https://*.alibaba.com/*",
    "https://www.aliexpress.com/*",
    "https://*.aliexpress.com/*",
    "https://*.aliexpress.us/*",
    "https://www.1688.com/*",
    "https://*.1688.com/*",
    "https://etsy.theglobalserviceteam.site/*"
  ],
  "action": {
    "default_title": "22Etsy Evidence Exporter settings",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://trends.ytuong.ai/*",
        "https://ytuong.me/*",
        "https://heyetsy.com/*",
        "https://www.etsy.com/*",
        "https://www.pinterest.com/*",
        "https://*.pinterest.com/*",
        "https://www.amazon.com/*",
        "https://www.alibaba.com/*",
        "https://*.alibaba.com/*",
        "https://www.aliexpress.com/*",
        "https://*.aliexpress.com/*",
        "https://*.aliexpress.us/*",
        "https://www.1688.com/*",
        "https://*.1688.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
