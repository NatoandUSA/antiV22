# systemd unit — Cloudflare tunnel for the Etsy dashboard
# Install:  sudo cp deploy/etsy-tunnel.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now etsy-tunnel
# Requires the tunnel credentials in /home/etsy/.cloudflared/ (cert.pem +
# <TUNNEL-ID>.json) — see DEPLOY_VPS.md step 7.
[Unit]
Description=Cloudflare tunnel (etsy-agent) for the Etsy dashboard
After=network-online.target etsy-web.service
Wants=network-online.target

[Service]
User=etsy
ExecStart=/usr/bin/cloudflared tunnel --config /home/etsy/etsy-agent/deploy/cloudflared-config.yml run etsy-agent
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
