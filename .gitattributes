# Normalize line endings across machines.
# Text files are stored as LF in the repo and checked out with each OS's
# native endings. This keeps Windows <-> Mac (M1) diffs clean.

* text=auto

# Explicit text types
*.py    text
*.md    text
*.txt   text
*.csv   text
*.json  text
*.ini   text
*.cfg   text
*.toml  text
*.yml   text
*.yaml  text
*.env.example text

# Shell scripts must stay LF even when checked out on Windows
*.sh    text eol=lf

# Binary files — never touch line endings
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.har   binary
*.pyc   binary
*.db    binary
*.sqlite binary
