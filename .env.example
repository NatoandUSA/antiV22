# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is git-ignored. This template is safe to commit.

# YTrends (trends.ytuong.ai). Preferred: an API token from your account.
# Used for the legacy REST client AND (optionally) as a bearer token for the
# official YTrends MCP server that powers the Market Pulse report.
YTRENDS_API_TOKEN=your_ytrends_api_token
# Fallback ONLY: a full browser session cookie. It expires; never share it.
YTRENDS_COOKIE=
# Official YTrends MCP endpoint. Leave blank to use the built-in default
# (https://mcp.trends.ytuong.ai/mcp). Only set this if YTrends moves it.
YTRENDS_MCP_URL=

# --- Optional trend cross-check sources (Market Pulse). Blank = skipped. ---
# Pinterest Trends: create a business app at developers.pinterest.com, request
# the trends scope, and paste the access token here (closest source to Etsy).
PINTEREST_ACCESS_TOKEN=
# X / Twitter API (PAID plan required): bearer token from your X dev project.
X_BEARER_TOKEN=

# OpenAI: image generation for `py main.py images`. Get a key at
# https://platform.openai.com/api-keys (each image is a paid API call).
OPENAI_API_KEY=your_openai_api_key

# Team report portal (`py main.py web`). WEB_PASSWORD is the team login and is
# REQUIRED — the server refuses to start without it. Use a strong value before
# exposing it via a tunnel. WEB_SECRET (optional) signs session cookies; if
# blank a random one is used per start (logs everyone out on restart).
WEB_PASSWORD=choose-a-strong-password
WEB_SECRET=
# How many days synced market data stays "fresh" (default 7).
YTRENDS_FRESH_DAYS=

# Printify: My Profile -> Connections, requires the catalog.read scope.
PRINTIFY_API_TOKEN=your_printify_api_token

# Optional POD suppliers — fill in only the ones you actually use.
SHINEON_API_KEY=your_shineon_key
BURGERPRINTS_API_KEY=your_burgerprints_key
PRINTWAY_API_KEY=your_printway_key
