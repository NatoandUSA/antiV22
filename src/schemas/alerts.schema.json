{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Internal alerts",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "kind", "message", "level"],
    "properties": {
      "id": {"type": "integer"},
      "kind": {"type": "string"},
      "message": {"type": "string"},
      "level": {"type": "string", "enum": ["info", "warn", "critical"]},
      "ref": {"type": "string"},
      "source": {"type": "string"},
      "resolved": {"type": "boolean"},
      "created_at": {"type": "string"},
      "updated_at": {"type": "string"}
    }
  }
}
