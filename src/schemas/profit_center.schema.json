{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Profit center sale record",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["record_id", "date", "sale_price", "net_profit"],
    "properties": {
      "record_id": {"type": "string"},
      "date": {"type": "string"},
      "keyword": {"type": "string"},
      "product_mode": {"type": "string"},
      "supplier": {"type": "string"},
      "sale_price": {"type": "number"},
      "product_cost": {"type": "number"},
      "shipping_cost": {"type": "number"},
      "listing_fee": {"type": "number"},
      "transaction_fee": {"type": "number"},
      "payment_fee": {"type": "number"},
      "offsite_ad_fee": {"type": "number"},
      "net_profit": {"type": "number"},
      "margin": {"type": "number"}
    }
  }
}
