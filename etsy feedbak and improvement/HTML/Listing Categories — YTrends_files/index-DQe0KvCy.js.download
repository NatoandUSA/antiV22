bán",extremePriceDisparity:"Chênh lệch giá cực lớn — sản phẩm cao cấp có thể làm lệch giá trung bình. Nên định giá theo trung vị thay vì trung bình",unusualPriceDistribution:"Phân bổ giá bất thường — xem lại giá trung vị so với giá trung bình trước khi định giá",oneSellerDominates:"Một người bán thống trị doanh thu — cần tạo khác biệt mạnh hoặc tìm ngách phụ",revenueUnevenlyDistributed:"Doanh thu phân bổ không đều — nghiên cứu chiến lược của người bán hàng đầu",marketStructureShifting:"Cấu trúc thị trường đang thay đổi — tiếp tục theo dõi",marketConvertingAbove3:"Thị trường có tỷ lệ chuyển đổi trên 3% — người mua có ý định mạnh, nên mở rộng dòng sản phẩm",solidConversion2to3:"Tỷ lệ chuyển đổi ổn định 2-3% — duy trì chất lượng và tiếp tục tối ưu sản phẩm",belowAverageConversion:"Tỷ lệ chuyển đổi dưới trung bình — xem lại giá và chất lượng sản phẩm",under1Conversion:"Tỷ lệ chuyển đổi dưới 1% — cần tối ưu toàn diện hoặc cân nhắc chuyển sang ngách khác",useGeoLimit:"Dùng tham số geo_limit để khám phá thêm quốc gia, lọc theo quốc gia để phân tích chuyên sâu",fragmentedMarketGoodSellThrough:"Thị trường phân mảnh, tỷ lệ bán tốt — tham gia với sản phẩm có sự khác biệt",fragmentedMarketTest:"Thị trường phân mảnh — thử với lượng tồn kho nhỏ để tìm sản phẩm tiềm năng",moderatelyConcentrated:"Mức tập trung vừa phải — tập trung vào giá trị độc đáo và SEO",highlyConcentratedMarket:"Thị trường tập trung cao — do ít người bán chi phối, nên xem xét ngách lân cận",mostListingsUse11Tags:"Đa số sản phẩm dùng trên 11 thẻ — hãy tập trung vào chất lượng thẻ hơn số lượng",roomForTagOptimization:"Còn dư địa tối ưu thẻ — nhắm tới 13 thẻ cho mỗi sản phẩm",significantSeoOpportunity:"Cơ hội SEO lớn — nhiều sản phẩm còn ít thẻ, thêm thẻ liên quan để tăng khả năng hiển thị",topPerformerExceptional:"Sản phẩm hàng đầu với chuyển đổi xuất sắc — nghiên cứu ảnh, tiêu đề, mô tả và giá của họ",topPerformer:"Sản phẩm hàng đầu — phân tích chiến lược sản phẩm và cách dùng thẻ của họ",strongListingSeo:"Sản phẩm mạnh với SEO tốt — so sánh thẻ và giá với sản phẩm của bạn",solidPerformer:"Hiệu suất tốt và ổn định — ghi nhận giá và cách định vị của họ",averageOrBelow:"Trung bình hoặc kém hơn — tham khảo để biết nên tránh gì, hoặc xác định mức sàn thị trường",highMomentumLowCompetition:"Tăng trưởng mạnh, cạnh tranh thấp — cơ hội đi đầu đang chờ bạn",strongTrendModerateCompetition:"Xu hướng mạnh, cạnh tranh vừa phải — cần hành động nhanh",buildingMomentumUncrowded:"Đang tăng trưởng, thị trường chưa đông — vào sớm để chiếm vị thế",activeKeywordDifferentiation:"Từ khóa đang hoạt động tốt — cần tạo khác biệt mạnh để nổi bật",moderateActivityMonitor:"Hoạt động ở mức vừa phải — theo dõi và chờ tín hiệu tăng tốc"},jo={featureRequest:"Bạn có ý tưởng? <a>Gửi yêu cầu tính năng</a>"},No={asOf:"tính đến {date}",days:"{count} ngày",avgAge:"tuổi TB {count} ngày"},ko={disclaimer:"YTrends phân tích một tập dữ liệu chọn lọc của Etsy. Các số liệu là ảnh chụp nhanh, không phải thời gian thực.",learnMore:"Tìm hiểu thêm"},_o={title:"YTrends hoạt động như thế nào",subtitle:"Các con số của chúng tôi mang ý nghĩa gì — và không mang ý nghĩa gì.",datasetTitle:"Một tập dữ liệu chọn lọc của Etsy",datasetBody:'YTrends thu thập một tập dữ liệu chọn lọc của Etsy chứ không phải toàn bộ thị trường. Các số tổng hợp ("sản phẩm trong kho dữ liệu", "doanh thu trong kho dữ liệu", v.v.) mô tả những gì chúng tôi đã thu thập, không phải toàn bộ Etsy.',snapshotsTitle:"Số liệu là ảnh chụp nhanh, không phải thời gian thực",snapshotsBody:'Dữ liệu của mỗi sản phẩm được ghi lại tại một thời điểm thu thập. Ngày "tính đến" trên mỗi thẻ cho biết khi nào sản phẩm đó được làm mới gần nhất. Trên toàn bộ kho dữ liệu, sản phẩm trung vị thường có tuổi 30–45 ngày. Một phần nhỏ mới hơn 14 ngày; một phần nhỏ hơn đã 3+ tháng tuổi.',windowTitle:'"24h" là 24h cuối của sản phẩm, không phải của bạn',windowBody:"sold_24h / views_24h đại diện cho khung 24 giờ kết thúc tại lần chụp nhanh gần nhất của mỗi sản phẩm — không phải 24 giờ vừa qua tính từ hiện tại. Một sản phẩm được làm mới lần cuối 30 ngày trước sẽ đóng góp khung 24 giờ của 30 ngày trước, không phải của hôm nay.",badgesTitle:"Cách đọc huy hiệu độ tươi",badgesBody:"Xanh = tươi (tuổi thấp hơn P25 của kho dữ liệu). Vàng = điển hình (giữa P25 và P75). Đỏ = cũ (già hơn P75). Ngưỡng này điều chỉnh theo độ tươi hiện tại của toàn bộ kho dữ liệu."},To={title:"Lịch Bán Hàng",subtitle:"Lên kế hoạch cho shop Etsy theo các mùa bán hàng chính. Xem khi nào nên đăng sản phẩm, khi nào người mua tăng, và kiểm tra dữ liệu từ khóa dạng ảnh chụp nhanh cho từng sự kiện.",monthView:"Tháng",yearView:"Năm",prevMonth:"Tháng trước",nextMonth:"Tháng sau",prevYear:"Năm trước",nextYear:"Năm sau",today:"Hôm nay",events:"Sự kiện",noEvents:"Không có sự kiện trong tháng này",noEventsYear:"Không có sự kiện để hiển thị",prepWindow:"Thời Gian Chuẩn Bị",peakBuying:"Cao Điểm Mua Sắm",eventDay:"Ngày Sự Kiện",startPrep:"Bắt đầu chuẩn bị",startPrepNow:"Bắt đầu ngay!",weeksBeforeEvent:"{weeks} tuần trước",eventCount:"{count} sự kiện",urgencyFuture:"Còn nhiều thời gian",urgencyUpcoming:"Bắt đầu lên kế hoạch",urgencyPrepare:"Chuẩn bị ngay",urgencyUrgent:"Hành động ngay!",urgencyPassed:"Sự kiện đã qua",suggestedKeywords:"Từ Khóa Gợi Ý",relatedCategories:"Danh Mục Liên Quan",tierMajor:"Lớn",tierMedium:"Trung bình",tierNiche:"Ngách",tierMajorDesc:"Sự kiện mua sắm lớn (VD: Giáng sinh, Ngày của Mẹ). Doanh số tăng mạnh nhất — chuẩn bị sớm và dự trữ hàng.",tierMediumDesc:"Sự kiện trung bình (VD: Phục sinh, Tựu trường). Tiềm năng bán tốt — nên chuẩn bị sản phẩm trước.",tierNicheDesc:"Sự kiện ngách nhỏ (VD: Ngày thú cưng, Pi Day). Đối tượng chuyên biệt — ít cạnh tranh, phù hợp người bán chuyên.",urgencyFutureDesc:"Sự kiện còn xa. Không vội — dùng thời gian này để nghiên cứu từ khóa và lên ý tưởng.",urgencyUpcomingDesc:"Sự kiện đang đến gần. Bắt đầu tạo sản phẩm, tối ưu thẻ tag và chuẩn bị hàng tồn.",urgencyPrepareDesc:"Sự kiện sắp diễn ra! Hoàn thiện sản phẩm, kiểm tra giá và đảm bảo hàng sẵn sàng giao.",urgencyUrgentDesc:"Sự kiện sắp hoặc đang diễn ra! Cơ hội cuối để đăng sản phẩm và đón nhu cầu.",urgencyPassedDesc:"Sự kiện đã qua. Xem lại doanh số và ghi nhận điều gì hiệu quả cho năm sau.",liveStats:"Ảnh Chụp Thị Trường",loadingStats:"Đang tải dữ liệu từ khóa...",noStatsAvailable:"Không có dữ liệu từ khóa",listings:"Sản phẩm",sellers:"Người bán",sold24h:"Đã bán (24h)",views24h:"Lượt xem (24h)",revenue:"Doanh thu",avgPrice:"Giá TB",competition:"Cạnh tranh",conversion:"Chuyển đổi",viewKeyword:"Xem chi tiết từ khóa",viewCategory:"Xem thống kê danh mục",prepTimeline:"Lịch Trình Chuẩn Bị",allCategories:"Tất Cả Danh Mục",filterCategory:"Lọc theo danh mục",opportunity:"Cơ hội",momentum:"Đà tăng",grade:"Hạng",action:"Hành động",actionEnterNow:"Vào ngay",actionStrongOpportunity:"Tiềm năng",actionWorthTesting:"Thử",actionCompetitive:"Cạnh tranh",actionMonitor:"Theo dõi",totalKeywords:"{count} từ khóa tìm thấy",totalMarketRevenue:"Doanh Thu Thị Trường",avgOpportunity:"TB Cơ Hội",avgMomentum:"TB Đà Tăng",sortBy:"Sắp xếp",discoveredKeywords:"Từ Khóa Khám Phá"},So={title:"Workflow Skills",subtitle:"Ba công thức ghép các tool YTrends thành câu trả lời rõ ràng dạng quyết định — đóng gói thành Claude Code plugin, cài bằng một lệnh duy nhất.",mcpPrereqLabel:"Cần MCP trước?",mcpPrereqBody:"Skills gọi YTrends MCP server bên dưới. Hãy đảm bảo bạn đã kết nối MCP server vào Claude Code trước khi cài plugin.",mcpPrereqLink:"Xem hướng dẫn cài MCP",catalogTitle:"3 skill",exampleLabel:"Thử nói:",items:{"should-i-sell":{tagline:"Có nên bán niche này không",description:"Nhận câu trả lời rõ ràng CÓ / CÓ NHƯNG / KHÔNG kèm 3 lý do và việc cần làm tiếp trước khi launch sản phẩm. Skill tự gọi research_keyword, analyze_competition và find_hot_listings.",example:"Có nên bán yếm vải lanh trên Etsy không?"},"whats-hot":{tagline:"Briefing thị trường 60 giây mỗi tuần",description:"5 bullet về niche đang lên + 3 niche đáng đào sâu. Tự kéo dữ liệu từ scout_opportunities, browse_rankings và trend_calendar.",example:"Tuần này có gì hot trên Etsy?"},"holiday-prep":{tagline:"Timeline launch mùa vụ",description:"Lập timeline launch cho bất kỳ ngày lễ hay peak season nào. Có sẵn quy tắc rank-lag và deadline Q4 (15/9 và 1/10), lấy từ trend calendar.",example:"Bao giờ nên launch cho Mother's Day?"}},pluginInstallTitle:"Cài plugin",pluginInstallBody:"Trong Claude Code, chạy hai lệnh sau. Claude Code sẽ fetch marketplace và load 3 skill:",pluginRestartNote:"Khởi động lại Claude Code nếu skill mới chưa xuất hiện trong autocomplete.",copyPluginInstall:"Copy commands",viewOnGithub:"Xem trên GitHub",philosophyLabel:"Vì sao chỉ 3?",philosophyBody:"Skills chỉ có giá trị khi bạn nhớ và dùng. Chúng tôi ship 3 workflow gọn cover các quyết định seller Etsy hay làm nhất — launch, quét tuần, kế hoạch lễ — và sẽ không thêm cho tới khi có signal rõ từ usage."},Co={title:"Cài YTrends MCP",subtitle:"Gắn nghiên cứu thị trường Etsy thẳng vào AI assistant của bạn. Miễn phí, public, giới hạn 60 request/phút/IP.",urlLabel:"URL MCP server",copyUrl:"Copy URL",whatIsTitle:"MCP là gì?",whatIsBody:"Model Context Protocol (MCP) là chuẩn mở cho phép AI assistant gọi tool bên ngoài. YTrends MCP server expose nghiên cứu keyword Etsy, scout xu hướng, ngách tiềm năng và phân tích danh mục thành 13 tool mà bất kỳ MCP client nào cũng dùng được.",toolsTitle:"13 tool có sẵn",toolsSubtitle:"Mỗi tool trả về JSON để assistant suy luận. Tên dưới đây khớp với tên server expose.",toolGroups:{keywords:"Keyword",listings:"Listing",market:"Thị trường",discovery:"Khám phá"},tools:{research_keyword:"Hồ sơ keyword đầy đủ — demand, cạnh tranh, dải giá, conversion, momentum, rank.",get_keyword_rank:"Chỉ lấy rank toàn cục, tier và lịch sử rank của 1 keyword.",find_trending_keywords:"Keyword có sales và views momentum mạnh gần đây.",search:"Tìm keyword theo chuỗi hoặc tag — discovery nhanh khắp index.",find_hot_listings:"Listing đột phá vượt niche về conversion hoặc sales.",find_hidden_gems:"Ngách ít người làm, conversion cao, cạnh tranh thấp.",browse_new_listings:"Listing mới tạo, lọc theo niche.",browse_rankings:"Keyword top-rank, biggest movers, hoặc mới nhất trong dataset.",market_snapshot:"Thống kê tổng: listing, seller, doanh thu, phân phối giá, top category.",analyze_competition:"Cạnh tranh theo niche: concentration, price skew, top-seller share, cấu trúc.",explore_niche:"Brief niche end-to-end gồm demand, cạnh tranh, giá và action đề xuất.",scout_opportunities:"Lọc niche cơ hội cao theo size, growth, hoặc filter cạnh tranh.",trend_calendar:"Sự kiện theo mùa kèm prep window, rank-lag và deadline Q4."},ctaTitle:"Dùng Claude Code?",ctaBody:"Cài 3 YTrends skills để có workflow nghiên cứu thị trường được dựng sẵn trên các tool này.",ctaLink:"Xem skills →"},Ro={new:"MỚI",newKeyword:"Mới",tier:"Tier {tier}",dataFreshness:{fresh:"Dữ liệu mới",partial:"Dữ liệu một phần",stale:"Dữ liệu cũ"}},Eo={priceUnavailable:"Chưa quy đổi được giá sang USD"},Po={metadata:Da,nav:Ma,theme:Ia,home:Oa,trending:Va,rankings:Ka,keyword:$a,sort:Ga,view:Fa,table:Ha,empty:Ua,stats:za,competition:Ba,opportunityBadge:Wa,card:qa,pagination:Ya,error:Xa,notFound:Qa,auth:Za,trial:Ja,languageSwitcher:eo,marketPulse:to,searchBar:no,tooltips:so,insights:io,categories:ro,hiddenGems:ao,hotListings:oo,spy:lo,revenueCalculator:co,browse:ho,hotReason:go,listingType:mo,gemTrend:uo,verdict:po,action:xo,listingVerdict:fo,dataConfidence:vo,marketStructure:yo,alertAction:bo,actionDesc:wo,common:jo,freshness:No,coverage:ko,methodology:_o,calendar:To,skills:So,mcp:Co,badges:Ro,listings:Eo};un.use(Li).init({resources:{en:{translation:La},vi:{translation:Po}},lng:"en",fallbackLng:"en",interpolation:{escapeValue:!1,prefix:"{",suffix:"}"}});function x(t){const{t:n,i18n:s}=as(),i=(r,a)=>n(`${t}.${r}`,a);return i.has=r=>s.exists(`${t}.${r}`),i}function ue(){const{i18n:t}=as();return t.language}const ys=h.createContext(null);function Ao({children:t}){const n=Ei(),[s,i]=h.useState(!1),[r,a]=h.useState(!1),[o,l]=h.useState(null