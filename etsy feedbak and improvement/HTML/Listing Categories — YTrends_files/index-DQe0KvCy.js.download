rites:"Favorites",created:"Created",updated:"Updated",viewMarketProducts:"View market products",goToShop:"Go to shop",tags:"Tags",categories:"Categories",convMultiplier:"{value}x conv",salesMultiplier:"{value}x sales",ageDays:"{count} days old",performance:"Performance",whyHot:"Why it's hot",showMore:"Show details",showLess:"Hide details"},Zr={paginationLabel:"Pagination",page:"Page {page}",pageOf:"Page {page} of {total}",previousPage:"Previous",nextPage:"Next",firstPage:"First page",lastPage:"Last page",goToPage:"Go to page {page}",morePages:"More pages",showingRange:"{from}–{to} of {total}"},Jr={title:"Something went wrong",description:"An unexpected error occurred. Please try again later.",tryAgain:"Try again"},ea={title:"Page not found",description:"The page you are looking for does not exist.",goHome:"Go to homepage"},ta={title:"YTrends",subtitle:"Enter your license key to access the dashboard.",placeholder:"License key",activate:"Activate",activating:"Activating...",logout:"Logout",invalidKey:"Invalid license key",deviceReplaced:"Your session was ended because this license key was activated on another device.",sessionExpired:"Your session has expired. Please log in again.",subscriptionExpired:"Your subscription has expired. Please renew to continue using YTrends.",subscriptionExpiredRetry:"Your subscription has expired. If you just renewed, please wait a few minutes and try again. Otherwise, <a>renew your license</a>.",email:"Email",subscription:"Subscription",daysLeft:"{count} days left",dailyQuota:"{used} / {limit} today",dailyQuotaTitle:"API requests used today",buyLicense:"Don't have a license key? <a>Get one at HeyEtsy.com</a>",renewLicense:"Renew at HeyEtsy.com",publicLinksLabel:"Or explore for free:",exploreMcp:"Explore MCP server",browseSkills:"Browse skills"},na={startCta:"Start 7-day free trial",dialogTitle:"Start your free trial",dialogBody:"Enter your email and we'll send you a 7-day trial key.",emailLabel:"Email",emailPlaceholder:"you@example.com",marketingOptin:"Occasionally email me Etsy market insights and product updates. Unsubscribe anytime.",submit:"Send me a trial key",sentTitle:"Check your inbox",sentBody:"We sent your trial key to {email}. Paste it on the previous screen to activate.",close:"Close",errorInvalid:"Please enter a valid email.",errorDisposable:"Please use a real email address — disposable inboxes are blocked.",errorAlreadyUsed:"This email already used its free trial. Buy a license at HeyEtsy to continue.",errorSendFailed:"Couldn't send right now. Please try again in a minute.",errorRateLimited:"Too many requests. Please wait a minute and try again.",errorTurnstile:"Please complete the verification and try again.",turnstileLabel:"Verifying you're human…",turnstileMissingConfig:"Verification isn't configured. Please contact support."},sa={label:"Language",en:"English",vi:"Tiếng Việt"},ia={title:"Data Overview",subtitle:"Key metrics and insights from the analyzed dataset.",keyMetrics:"Key Metrics",priceDistribution:"Price Distribution",topTags:"Top Tags",topCountries:"Top Countries",topCategories:"Top Categories",totalListings:"Listings in dataset",totalSellers:"Sellers in dataset",totalRevenue:"Revenue in dataset",sold24h:"Sold 24h",views24h:"Views 24h",avgPrice:"Avg Price",conversionRate:"Conversion Rate",medianPrice:"Median",avgPriceLabel:"Average",tagHealth:"Tag Health",tagsUtilization:"Tags Utilization",fullTagsListings:"Full Tags",uniqueTags:"Unique Tags",avgTagLength:"Avg Tag Length",singleWordTags:"Single-Word Tags",sellThroughRate:"Sell-Through Rate",estDailyRevenue:"Est. Daily Revenue",marketHealth:"Performance Health",viewsPerListing:"Views / Listing",listingsPerSeller:"Listings / Seller",pctTopSellers:"Top Sellers %",p25:"P25",p75:"P75",p90:"P90",sellerTiers:"Seller Tiers",tier:"Tier",sellers:"Sellers",listings:"Listings",avgRevenueLabel:"Avg Revenue",listingsHealth:"Listings Health",withTraction:"With Traction",withSales:"With Sales",pricePercentiles:"Price Percentiles",priceBuckets:"Price Buckets",convRate:"Conv. Rate",sold24hLabel:"Sold/24h",revenueLabel:"Revenue",listingsLabel:"Listings",revenueToggle:"Revenue",listingsToggle:"Listings",listingAnalytics:"Listing Analytics",avgListingAge:"Avg Listing Age",viewsVelocity:"Views Velocity",newListings30d:"New Listings (30d)",avgQuantity:"Avg Quantity",listingTypes:"Listing Types",sellerAnalytics:"Seller Intelligence",sellerConcentration:"Seller Concentration",revenuePerSeller:"Revenue / Seller",salesPerSellerDay:"Sales / Seller / Day",newSellers:"New Sellers",engagementFunnel:"Engagement Funnel",avgFavRate:"Avg Fav Rate",favToSalesRatio:"Favorites / Sale",avgTagCount:"Avg Tags / Listing",revenuePercentiles:"Revenue Percentiles",revenueP25:"P25",revenueP50:"P50 (Median)",revenueP75:"P75",revenueP90:"P90",medianRevenue:"Median Revenue",categorySaturation:"Category Saturation",revenueTop10:"Revenue % (Top 10)",pctOfListings:"% of Listings"},ra={placeholder:"Search keywords (e.g. press on nails, vintage jewelry)...",clear:"Clear search"},aa=JSON.parse(`{"rank":"Global keyword rank (1 = best). Computed daily from a freshness-weighted composite of demand, viability, momentum, and inverse-competition. Smaller numbers mean stronger keywords.","tier":"Tier 1 = top 1,000 keywords. Tier 2 = ranks 1,001–10,000. Tier 3 = below 10,000. Tiers stay meaningful even when the absolute rank gets large.","firstSeen":"Earliest snapshot date this keyword appeared in our data. If marked 'before {date}', the keyword existed before our records start, so the true emergence date is unknown.","dataFreshness":"How recently the listings backing this rank were refreshed. 'fresh' = ≥50% in the last 7 days, 'partial' = ≥20%, 'stale' = under 20%. Stale ranks are still real but built on older data.","totalListings":"Total active listings for this keyword. Under 500 = low competition, great for new sellers.","totalSellers":"Unique sellers in this niche. Compare with listings count — fewer sellers with many listings means established players dominate.","avgPrice":"Average listing price. Compare with the sweet spot price below to find the best pricing strategy.","medianPrice":"Middle price point for listings in this niche.","totalRevenue":"Total estimated revenue across all listings. High revenue + low sellers = profitable niche to enter.","avgRevenue":"Revenue per listing — directly shows earning potential. Compare across keywords to find the most profitable ones.","conversionRate":"Views that result in a sale. Above 3% is excellent on Etsy, 1-3% is average. High conversion with low competition = ideal niche.","avgFavorites":"Average favorites per listing. High favorites but low sales may indicate window-shopping — check conversion rate.","avgViews":"Average views per listing. More views means more exposure, but what matters most is conversion.","sold24h":"Average daily sales per listing. Above 1.0 = strong demand, good sign for new entrants.","sweetSpot":"The price range where listings convert best. Price your products here for the best chance of sales.","competitionLow":"Low competition — fewer sellers, easier to rank.","competitionMedium":"Medium competition — moderate number of sellers.","competitionHigh":"High competition — many sellers, harder to stand out.","competitionVeryHigh":"Very high competition — extremely saturated market.","opportunityA":"Grade A — excellent opportunity with high demand and low competition.","opportunityB":"Grade B — good opportunity with decent demand.","opportunityC":"Grade C — average opportunity, moderate competition.","opportunityD":"Grade D — low opportunity with high competition and low demand.","opportunityN":"Grade N — insufficient data to determine opportunity level.","keyword":"The search term or tag used on Etsy. Click to see full analysis.","listings":"Active listings for this keyword. Under 500 = low competition, over 10,000 = very saturated.","sellers":"Unique shops selling this keyword. Fewer sellers = easier to stand out.","revenue":"Estimated total revenue. Higher revenue with fewer sellers = strong opportunity.","conversion":"Conversion Rate — % of views that result in a purchase. Good: > 3% | Average: 1-3% | Weak: < 1%. High conversion + low competition = ideal niche.","competition":"Market saturation based on seller count and listing density. Low competition niches are easiest to enter.","opportunity":"Opportunity Score (0-100) — combines demand, competition, and sales potential. Good: > 70 | Average: 40-70 | Weak: < 40. Higher = easier to succeed.","favRate":"Favorites per view. Above 5% means high buyer interest. Compare with conversion — high favs but low sales may indicate pricing issues.","sold24hKeyword":"Sold/24h — average daily sales per listing. Good: > 1.0 | Average: 0.3-1.0 | Weak: < 0.3. Strong demand means easier sales.","momentum":"Momentum (0-100) — trend strength over recent period. Good: > 60 (enter early!) | Average: 30-60 | Weak: < 30 (slowing down).","views24h":"Recent traffic volume. Compare with sold24h to gauge conversion efficiency.","price":"Current listing price.","type":"Listing type (e.g. handmade, vintage, supply).","totalSold":"Total number of units sold since the listing was created.","shopSales":"Total sales count of the seller's entire shop.","age":"How long ago this listing was first created.","avgRevenueTable":"Average revenue per listing for this keyword.","cardSold24h":"Units sold by this listing in the 24-hour window ending at this listing's last snapshot (not the last 24 hours from now).","cardViews24h":"Views this listing received in the 24-hour window ending at this listing's last snapshot (not the last 24 hours from now).","cardTotalSold":"Total units sold since this listing was created.","cardRevenue":"Estimated total revenue from this listing.","cardAvgViews":"Average daily views and total views for this listing.","cardFavorites":"Favorite rate and total favorites for this listing.","cardCreated":"Date this listing was first published on Etsy.","cardUpdated":"When this listing was last modified by the seller.","cardConversion":"This listing's conversion rate (sales / views).","cardShopSold":"Daily sales rate across the seller's entire shop.","mpTotalListings":"Total listings in the analyzed dataset.","mpTotalSellers":"Unique sellers found in the analyzed listings.","mpTotalRevenue":"Estimated total revenue across the analyzed listings.","mpSold24h":"Total units sold across all listings, each measured in the 24-hour window ending at its last snapshot.","mpViews24h":"Total views across all listings, each measured in the 24-hour window ending at its last snapshot.","mpAvgPrice":"Average listing price across the analyzed dataset.","mpMedianPrice":"Median price in the dataset — half of listings are priced above, half below.","mpConversionRate":"Average conversion rate (sales / views) across all listings.","mpSellThroughRate":"Share of indexed listings that recorded a sale in the 24-hour window ending at each listing's last snapshot.","mpEstDailyRevenue":"Estimated daily revenue across the analyzed listings.","mpViewsPerListing":"Average number of views per listing, measured in the 24-hour window ending at each listing's last snapshot.","mpListingsPerSeller":"Average number of listings per seller.","mpPctTopSellers":"Percentage of sellers that account for the majority of sales.","mpWithTraction":"Percentage of listings that have received favorites or views recently.","mpWithSales":"Percentage of listings that have made at least one sale.","mpPriceP25":"25th percentile price — 75% of listings are priced higher.","mpPriceP75":"75th percentile price — only 25% of listings are priced higher.","mpPriceP90":"90th percentile price — only 10% of listings are priced higher.","mpAvgListingAge":"Average age of listings in the dataset, in days.","mpViewsVelocity":"Ratio of recent views (24h) to average daily views — above 1.0 means accelerating.","mpNewListings30d":"Percentage of listings created in the last 30 days.","mpAvgQuantity":"Average available quantity per listing, capped at Etsy's 999-per-listing maximum.","mpListingTypes":"Breakdown of listing types (handmade, vintage, supply, etc.).","mpSellerConcentration":"Herfindahl-Hirschman Index (0-10000). Below 1500 = fragmented, 1500-2500 = moderate, above 2500 = concentrated.","mpRevenuePerSeller":"Average estimated revenue per seller in the market.","mpSalesPerSellerDay":"Average daily sales per seller — indicates demand-to-supply ratio.","mpNewSellers":"Percentage of sellers with low total shop sales, indicating new market entrants.","mpAvgFavRate":"Average favorite rate (favorites / views) across all listings in the market.","mpFavToSalesRatio":"Average number of favorites per sale — lower means higher purchase intent.","mpAvgTagCount":"Average number of tags per listing. Higher utilization = better discoverability.","mpRevenueP25":"25th percentile revenue — 75% of listings earn more than this.","mpRevenueP50":"Median revenue — half of listings earn more, half earn less.","mpRevenueP75":"75th percentile revenue — only 25% of listings earn more.","mpRevenueP90":"90th percentile revenue — only 10% of listings earn more.","mpRevenueTop10":"Percentage of total revenue captured by the top 10 sellers.","mpPctOfListings":"Percentage of total listings in this price bucket.","mpCategorySaturation":"How saturated the top categories are — higher means more concentrated competition.","relatedRelevance":"How often this keyword co-occurs with the searched term. Higher = more related.","gemScore":"Gem Score (0-100) — niche potential combining conversion, low competition, and sales velocity. Good: > 70 | Average: 40-70 | Weak: < 40.","listingsPerSeller":"Listings per seller — below 5 means low saturation (good). Above 15 means established sellers dominate.","performanceScore":"How much this listing outperforms its niche (0-100). Study high-scoring listings to learn winning strategies.","convMultiplier":"How many times this listing's conversion exceeds the niche average.","salesMultiplier":"How many times this listing's sales exceed the niche average.","hotReason":"Why this listing was flagged as hot (fast starter, conversion outlier, etc.).","ageDays":"How many days since this listing was first created.","country":"Country where the seller's shop is located.","severity":"Alert severity based on the magnitude of the detected anomaly.","alertType":"Type of activity spike detected (sales, views, or competition shift).","deviation":"How far above normal the metric has deviated (as a multiplier).","views24hAvg":"Average views per listing, measured in the 24-hour window ending at each listing's last snapshot.","signalStrength":"Strength of the market signal (0-100). Higher = stronger dynamics.","moverType":"Type of market dynamic detected (competition, pricing, or revenue pattern).","priceSkewRatio":"Ratio of average to median price — higher means pricing is skewed upward.","topSellerShare":"Percentage of total revenue captured by the top seller in this niche.","competitionScore":"Competition intensity (0-100). Below 30 = easy to enter, 30-60 = moderate effort needed, above 60 = very competitive.","listingScore":"Listing performance score (0-100) comparing this listing to keyword averages.","avgViewsVelocity":"Average views velocity — how quickly listings in this niche accumulate views.","gemTrend":"Niche trend: rising (growing opportunity), stable, or fading (declining).","priceP25":"25th percentile price — 75% of listings are priced higher.","priceP75":"75th percentile price — only 25% of listings are priced higher.","avgViews24h":"Average views per listing, measured in the 24-hour window ending at each listing's last snapshot.","listingsPerSellerKw":"Average number of listings per seller for this keyword — lower means less saturated.","revenuePerSellerKw":"Average revenue per seller for this keyword.","sellThroughRateKw":"Percentage of available inventory sold for this keyword, measured in the 24-hour window ending at each listing's last snapshot.","growthScore":"Overall growth score (0-100) combining sales, views, revenue, and conversion trends.","growthVerdict":"Growth classification based on multi-metric acceleration analysis.","salesGrowth":"Percentage change in sales compared to the previous period.","viewsGrowth":"Percentage change in views compared to the previous period.","revenueGrowth":"Percentage change in revenue compared to the previous period.","convGrowth":"Percentage change in conversion rate compared to the previous period.","recommendedAction":"What to do next — based on competition, demand, and trend analysis. Follow this for the best results.","viewsVelocity":"Views Velocity — view acceleration rate (recent vs average). Good: > 1.5 (growing fast!) | Average: 0.8-1.5 | Weak: < 0.8 (slowing down).","dataConfidence":"Confidence level of the data analysis (High, Medium, Low).","alertAction":"Recommended action for this alert.","alertDirection":"Direction of the detected trend (up or down).","learnFrom":"Key takeaway from this hot listing's success.","whyHotDetail":"Detailed explanation of why this listing is performing well.","priceUsd":"Price converted to USD for comparison.","priceVsNiche":"How this listing's price compares to the niche average.","marketInsight":"AI-generated insight about this market dynamic.","signalDirection":"Direction of the market signal (bullish or bearish).","competitiveInsights":"AI analysis of this listing's competitive positioning.","listingVerdict":"Overall verdict on listing performance.","tagCount":"Number of tags on this listing.","actionDetail":"Detailed description of the recommended action.","estimatedRevenue":"Estimated revenue potential for this category.","priceRange":"Recommended price range for this category.","confidenceLevel":"Confidence level of this opportunity assessment.","demandSupplyRatio":"Ratio of demand to supply — higher means more demand.","revenueMaxPrice":"Price point that maximizes revenue based on market data.","recPriceRange":"Recommended price range based on market analysis.","recommendedPriceRange":"Recommended price range based on market analysis.","competitionChange":"Percentage change in competition level.","isNewKeyword":"Whether this keyword is newly appeared in the market."}`),oa={title:"Insights",subtitle:"Advanced analytics and market intelligence for Etsy sellers.",gemTitle:"Hidden Gems",gemDesc:"Discover underserved niches with high conversion and low competition.",hotTitle:"Hot Listings",hotDesc:"Find breakout listings outperforming their niche in sales and conversions."},la={title:"Categories",subtitle:"Browse and analyze Etsy categories to find the best opportunities.",browseTab:"Browse",statsTab:"Performance",loading:"Loading...",count:"Showing {from}–{to} of {total} categories",countAll:"{total} categories",emptyTitle:"No categories found",emptySubtitle:"Try adjusting your filters or search terms.",statsTitle:"Category Performance",statsSubtitle:"Analyze category metrics, competition levels, and opportunity scores.",statsCount:"Showing {from}–{to} of {total} categories",statsCountAll:"{total} categories",performanceLink:"Category Performance",performanceLinkDesc:"Detailed performance metrics and competition analysis for all categories."},ca={title:"Hidden Gems",subtitle:"Underserved niches with high conversion rates and low competition. Find your next opportunity.",loading:"Loading...",count:"Showing {from}–{to} of {total} hidden gems",countAll:"{total} hidden gems",emptyTitle:"No hidden gems found",emptySubtitle:"Try adjusting your filters or check back later."},da={title:"Hot Listings",subtitle:"Breakout listings significantly outperforming their niche averages.",loading:"Loading...",count:"Showing {from}–{to} of {total} hot listings",countAll:"{total} hot listings",emptyTitle:"No hot listings at the moment",emptySubtitle:"Check back later for breakout listings."},ha={title:"Spy",subtitle:"Learn from top-performing listings and discover what makes them sell.",tabHot:"Hot Listings",tabBrowse:"Browse All"},ga={title:"Revenue Estimate",price:"Your Price",seller:"seller",stageLabel_new:"New (0-3 months)",stageLabel_growing:"Growing (6-12 months)",stageLabel_top:"Top performer (1yr+)",salesPerMonth:"sales/mo",newSellerHint:"After 6-12 months you could reach ~{amount}/mo"},ma={title:"Browse Listings",subtitle:"Explore all active listings with search, filters, sorting, and pagination.",count:"Showing {from}–{to} of {total} listings",countAll:"{total} listings",emptyTitle:"No listings found",emptySubtitle:"Try adjusting your search or filters.",filters:"Filters",clearFilters:"Clear Filters",applyFilters:"Apply",activeFilters:"{count} active",priceRange:"Price Range",minPrice:"Min price",maxPrice:"Max price",country:"Country",countryPlaceholder:"e.g. US, GB, VN",minSales:"Min Daily Sales",minTotalSold:"Min Total Sold",minRevenue:"Min Revenue",minConversion:"Min Conversion",minFavorites:"Min Favorites",minViews:"Min Views",maxSales:"Max Daily Sales",maxTotalSold:"Max Total Sold",maxRevenue:"Max Revenue",maxConversion:"Max Conversion",maxFavorites:"Max Favorites",maxViews:"Max Views",dailySales:"Daily Sales",totalSoldRange:"Total Sold",revenueRange:"Revenue ($)",conversionRange:"Conversion Rate",favoritesRange:"Favorites",viewsRange:"Views",listingAge:"Listing Age (days)",minAge:"Min age",maxAge:"Max age",performanceFilters:"Performance Minimums",sortDirection:"Direction",descending:"Descending",ascending:"Ascending"},ua={all:"All Reasons",fast_starter:"Fast Starter",conversion_outlier:"Conversion Outlier",sales_outlier:"Sales Outlier",outperformer:"Outperformer"},pa={all:"All Types",physical:"Physical",download:"Digital Download"},xa={rising_gem:"Rising",stable_gem:"Stable",fading_gem:"Fading"},fa={HIGH_OPPORTUNITY:"High Opportunity",PROMISING:"Promising",COMPETITIVE:"Competitive",SATURATED:"Saturated",MODERATE:"Moderate",ENTER_NOW:"Enter Now",PREPARE:"Prepare",DIFFERENTIATE:"Differentiate",AVOID:"Avoid",RESEARCH:"Research",ACTIVE:"Active",GROWING:"Growing",UNDEREXPLORED:"Underexplored",sweetSpot:"Best Price",priceRange:"Price Range",revenueMaxPrice:"Max Revenue Price"},va={all:"All Actions",ENTER_NOW:"Enter Now",STRONG_OPPORTUNITY:"Strong Opportunity",RISING_DEMAND:"Rising Demand",HIGH_VALUE_NICHE:"High Value Niche",CONVERSION_GAP:"Conversion Gap",MONITOR:"Monitor",ENTER_IMMEDIATELY:"Enter Immediately",PREPARE:"Prepare",TEST:"Test",WATCH:"Watch",CAPITALIZE:"Capitalize",REVIEW:"Review",MAINTAIN:"Maintain",WAIT:"Wait",ACT_NOW:"Act Now",EXPAND:"Expand",PIVOT:"Pivot",EARLY_MOVER:"Early Mover",RIDE_WAVE:"Ride the Wave",GROWING_NICHE:"Growing Niche",TRENDING:"Trending",WORTH_TESTING:"Worth Testing",COMPETITIVE:"Competitive",MUST_USE:"Must Use",CONSIDER:"Consider",NICHE:"Niche",SKIP:"Skip",THRIVING:"Thriving",HEALTHY:"Healthy",NEUTRAL:"Neutral",SLUGGISH:"Sluggish",OPPORTUNITY:"Opportunity",EXPLORE:"Explore",COMPETE:"Compete",CAUTION:"Caution",WELL_OPTIMIZED:"Well Optimized",UNDER_TAGGED:"Under Tagged",ACTIVE:"Active",UNDEREXPLORED:"Underexplored",SATURATED:"Saturated",DIFFERENTIATE:"Differentiate",AVOID:"Avoid",RESEARCH:"Research",OPTIMIZE:"Optimize",INSUFFICIENT_DATA:"Insufficient Data",RECONSIDER:"Reconsider",GROWING:"Growing",URGENT:"Urgent",ACT_FAST:"Act Fast",AWARE:"Aware",WARNING:"Warning",MAJOR_MARKET:"Major Market",GROWING_MARKET:"Growing Market",NICHE_MARKET:"Niche Market",MODERATE:"Moderate",STUDY:"Study",LEARN:"Learn",BENCHMARK:"Benchmark",REFERENCE:"Reference",ALERT:"Alert",NOTE:"Note",PRICING_ALERT:"Pricing Alert",PRICING_NOTE:"Pricing Note",DOMINANCE_ALERT:"Dominance Alert",CONCENTRATION_NOTE:"Concentration Note",ANALYZE:"Analyze"},ya={TOP_PERFORMER:"Top Performer",STRONG:"Strong",AVERAGE:"Average",BELOW_AVERAGE:"Below Average"},ba={HIGH:"High Confidence",MEDIUM:"Medium Confidence",LOW:"Low Confidence"},wa={FRAGMENTED:"Fragmented",MODERATE:"Moderate",CONCENTRATED:"Concentrated"},ja={ACT_NOW:"Act Now",MONITOR:"Monitor",INVESTIGATE:"Investigate",CAPITALIZE:"Capitalize"},Na={goodSalesLowDensity:"Good sales with low density — worth exploring",buildingMomentum:"Building momentum with room for new sellers",fewListingsUntapped:"Few listings and sellers — potential untapped opportunity",crowdedCategory:"Crowded category — strong differentiation required",standardActivityLevels:"Standard activity levels — research further before entering",highOpportunityCategory:"High opportunity category — strong conversion with low competition",promisingCategory:"Promising category — create quality listings and test market response",competitiveButValuable:"Competitive but valuable — need unique positioning and strong SEO",saturatedCategory:"Saturated category — consider sub-categories or adjacent niches",moderatePotentialCategory:"Moderate potential — dig deeper into sub-categories for specific opportunities",currencyNotSupported:"Currency not supported for USD conversion — prices may be inaccurate",significantMarketShare:"Significant market share — consider localizing listings for this currency",moderatePresence:"Moderate presence — monitor for growth opportunities",smallMarket:"Small market — focus efforts on larger currency markets first",risingGemHighScore:"Rising gem with high score — first-mover advantage, list products now",risingGem:"Rising gem — research products and prepare listings",stableNicheProvenDemand:"Stable niche with proven demand — enter with quality products",stableNiche:"Stable niche — test with a few listings to validate",fadingStillScoring:"Fading but still scoring well — watch for trend reversal",decliningInterest:"Declining interest — check back periodically",newListingSuccess:"New listing success — analyze title, tags, photos, and pricing strategy for quick wins",highConversion:"High conversion — examine listing photos, description, pricing, and reviews",highVolumeSeller:"High volume seller — analyze their SEO, pricing, and product positioning",strongPerformer:"Strong performer — review their complete listing strategy",keywordExploding:"Keyword exploding — list products immediately before competition catches up",growingKeyword:"Growing keyword — increase listings and optimize existing ones",stablePerformance:"Stable performance — focus on conversion and pricing optimization",keywordDecliningReview:"Keyword declining — review pricing, refresh listings, or pivot",rapidDecline:"Rapid decline — reduce inventory and explore alternative keywords",insufficientHistoricalData:"Insufficient historical data — continue tracking",massiveSalesSpike:"Massive sales spike — list related products NOW and increase inventory",strongSalesSpike:"Strong sales spike — add products and optimize listings for this keyword",salesAboveNormal:"Sales above normal — watch for sustained trend",highSearchInterest:"High search interest — ensure you have products listed for this keyword",viewsIncreasing:"Views increasing — prepare listings in case demand follows",competitionFlooding:"Competition flooding in — strengthen unique value proposition",competitionChanging:"Competition changing — monitor pricing and positioning",keepWatching:"Keep watching this keyword",highOpportunityLowCompetition:"High opportunity with low competition — list products immediately",goodPotentialManageable:"Good potential with manageable competition — create optimized listings",moderateOpportunityTest:"Moderate opportunity — test with a few listings first",decentMarketCrowded:"Decent market but crowded — need strong differentiation",lowOpportunityHighCompetition:"Low opportunity or high competition — watch for changes",gradeAKeyword:"Grade-A keyword — high conversion, good sales, low competition",goodMetricsRoomToGrow:"Good metrics with room to grow",solidKeyword:"Solid keyword — test with optimized listings",moderatePotentialPricing:"Moderate potential — focus on pricing and SEO quality",notEnoughListings:"Not enough listings to evaluate — check back later",lowConversionAndSales:"Low conversion and sales — consider alternative keywords",stronglyAssociatedTag:"Strongly associated tag with good conversion — add to all listings",positivelyAssociatedTag:"Positively associated tag — test on listings",mildlyAssociated:"Mildly associated — use for specific product variations",weakOrNegativeAssociation:"Weak or negative association — unlikely to help",keywordTrendingUp:"Keyword trending up — increase inventory and optimize listings",keywordDecliningCheck:"Keyword declining — check pricing, competition changes, or seasonal factors",stableKeyword:"Stable keyword — focus on conversion optimization",insufficientDataMonitoring:"Insufficient data — continue monitoring",unusualCompetitionDensity:"Unusual competition density — either oversaturated or underserved niche. Check listings_per_seller for direction",competitionStructureDiffers:"Competition structure differs from norm — analyze seller distribution",extremePriceDisparity:"Extreme price disparity — premium products may be skewing averages. Price to median, not mean",unusualPriceDistribution:"Price distribution is unusual — review median_price vs avg_price before pricing",oneSellerDominates:"One seller dominates revenue — differentiate heavily or find sub-niche",revenueUnevenlyDistributed:"Revenue unevenly distributed — study top seller strategy",marketStructureShifting:"Market structure shifting — keep watching",marketConvertingAbove3:"Market converting above 3% — strong buyer intent, consider expanding product line",solidConversion2to3:"Solid 2-3% conversion — maintain quality and optimize listings",belowAverageConversion:"Below-average conversion — review pricing and listing quality",under1Conversion:"Under 1% conversion — significant optimization needed or consider different niches",useGeoLimit:"Use geo_limit parameter to explore more countries, filter by country for deep dives",fragmentedMarketGoodSellThrough:"Fragmented market with good sell-through — enter with differentiated products",fragmentedMarketTest:"Fragmented market — test with small inventory to find winning products",moderatelyConcentrated:"Moderately concentrated — focus on unique value proposition and SEO",highlyConcentratedMarket:"Highly concentrated market — dominated by few sellers, consider adjacent niches",mostListingsUse11Tags:"Most listings use 11+ tags — focus on tag quality over quantity",roomForTagOptimization:"Room for tag optimization — aim for 13 tags per listing",significantSeoOpportunity:"Significant SEO opportunity — many listings have few tags, add relevant tags to gain visibility",topPerformerExceptional:"Top performer with exceptional conversion — study photos, title, description, and pricing",topPerformer:"Top performer — analyze their complete listing strategy and tag usage",strongListingSeo:"Strong listing with good SEO — compare your tags and pricing",solidPerformer:"Solid performer — note their pricing and positioning",averageOrBelow:"Average or below — identifies what NOT to do or market floor",highMomentumLowCompetition:"High momentum + low competition — first-mover advantage available",strongTrendModerateCompetition:"Strong trend with moderate competition — act quickly",buildingMomentumUncrowded:"Building momentum in uncrowded space — position early",activeKeywordDifferentiation:"Active keyword — need strong differentiation to stand out",moderateActivityMonitor:"Moderate activity — monitor for acceleration"},ka={featureRequest:"Have an idea? <a>Request a feature</a>"},_a={asOf:"as of {date}",days:"{count}d",avgAge:"avg age {count}d"},Ta={disclaimer:"YTrends analyzes a curated subset of Etsy listings. Metrics are snapshots, not live.",learnMore:"Learn more"},Sa={title:"How YTrends works",subtitle:"What our numbers mean — and what they don't.",datasetTitle:"A curated subset of Etsy",datasetBody:`YTrends indexes a curated subset of Etsy listings rather than the full marketplace. Aggregate totals ("listings in dataset", "revenue in dataset", etc.) describe what we've indexed, not all of Etsy.`,snapshotsTitle:"Metrics are snapshots, not live",snapshotsBody:`Each listing's data is captured at an ingest point in time. The "as of" date on every card shows when that particular listing was last refreshed. Across the full dataset the median listing is typically 30–45 days old. A small share is fresher than 14 days; a smaller share is 3+ months old.`,windowTitle:`"24h" means the listing's last 24h, not yours`,windowBody:"sold_24h / views_24h represent the 24-hour window ending at each listing's last snapshot — not the last 24 hours from now. A listing last refreshed 30 days ago contributes a 24h window from 30 days ago, not from today.",badgesTitle:"Reading the freshness badge",badgesBody:"Green = fresh (age below the dataset P25). Amber = typical (between P25 and P75). Red = stale (older than P75). Thresholds adapt to current dataset-wide freshness."},Ca={title:"Seller Calendar",subtitle:"Plan your Etsy shop around key selling seasons. See when to start listing, when buyers peak, and check snapshot keyword stats for each event.",monthView:"Month",yearView:"Year",prevMonth:"Previous month",nextMonth:"Next month",prevYear:"Previous year",nextYear:"Next year",today:"Today",events:"Events",noEvents:"No events this month",noEventsYear:"No events to display",prepWindow:"Prep Window",peakBuying:"Peak Buying",eventDay:"Event Day",startPrep:"Start preparing",startPrepNow:"Start now!",weeksBeforeEvent:"{weeks}w before",eventCount:"{count} events",urgencyFuture:"Plenty of Time",urgencyUpcoming:"Start Planning",urgencyPrepare:"Prep Now",urgencyUrgent:"Act Now!",urgencyPassed:"Past Event",suggestedKeywords:"Suggested Keywords",relatedCategories:"Related Categories",tierMajor:"Major",tierMedium:"Medium",tierNiche:"Niche",tierMajorDesc:"High-traffic shopping event (e.g. Christmas, Mother's Day). Expect the biggest sales spikes — prepare early and stock up.",tierMediumDesc:"Moderate-traffic event (e.g. Easter, Back to School). Good sales potential — worth preparing listings in advance.",tierNicheDesc:"Smaller or niche event (e.g. National Pet Day, Pi Day). Targeted audience — less competition, great for specialized sellers.",urgencyFutureDesc:"Event is far away. No rush — use this time to research keywords and plan your designs.",urgencyUpcomingDesc:"Event is approaching. Start creating listings, optimizing tags, and preparing inventory now.",urgencyPrepareDesc:"Event is soon! Finalize your listings, check pricing, and ensure inventory is ready to ship.",urgencyUrgentDesc:"Event is imminent or happening now! Last chance to publish listings and capture demand.",urgencyPassedDesc:"This event has passed. Review your sales data and note what worked for next year.",liveStats:"Market Snapshot",loadingStats:"Loading keyword stats...",noStatsAvailable:"No keyword data available",listings:"Listings",sellers:"Sellers",sold24h:"Sold (24h)",views24h:"Views (24h)",revenue:"Revenue",avgPrice:"Avg Price",competition:"Competition",conversion:"Conversion",viewKeyword:"View keyword details",viewCategory:"View category stats",prepTimeline:"Preparation Timeline",allCategories:"All Categories",filterCategory:"Filter by category",opportunity:"Opportunity",momentum:"Momentum",grade:"Grade",action:"Action",actionEnterNow:"Enter Now",actionStrongOpportunity:"Strong",actionWorthTesting:"Test",actionCompetitive:"Competitive",actionMonitor:"Monitor",totalKeywords:"{count} keywords found",totalMarketRevenue:"Market Revenue",avgOpportunity:"Avg Opportunity",avgMomentum:"Avg Momentum",sortBy:"Sort by",discoveredKeywords:"Discovered Keywords"},Ra={title:"Workflow Skills",subtitle:"Three recipes that chain YTrends tools into clear, decision-shaped answers — packaged as a Claude Code plugin you install in one command.",mcpPrereqLabel:"Need MCP first?",mcpPrereqBody:"Skills call the YTrends MCP server under the hood. Make sure the server is connected to your Claude Code before installing the plugin.",mcpPrereqLink:"See MCP install guide",catalogTitle:"The 3 skills",exampleLabel:"Try saying:",items:{"should-i-sell":{tagline:"Yes/no verdict on a niche",description:"Get a clear GO / CONDITIONAL / NO-GO answer with 3 reasons and next steps before launching a product idea. The skill calls research_keyword, analyze_competition, and find_hot_listings for you.",example:"Should I sell linen aprons on Etsy?"},"whats-hot":{tagline:"Weekly 60-second market briefing",description:"5 bullets on what's rising this week + 3 niches worth investigating. Pulls scout_opportunities, browse_rankings, and trend_calendar so you don't have to.",example:"What's hot on Etsy this week?"},"holiday-prep":{tagline:"Seasonal launch timeline",description:"Build a launch timeline for any holiday or peak season. Rank-lag math and Q4 deadlines (Sept 15 / Oct 1) baked in, sourced from the trend calendar.",example:"When should I launch for Mother's Day?"}},pluginInstallTitle:"Install the plugin",pluginInstallBody:"In Claude Code, run these two commands. Claude Code will fetch the marketplace and load the three skills:",pluginRestartNote:"Restart Claude Code if the new skills don't appear in autocomplete.",copyPluginInstall:"Copy commands",viewOnGithub:"View on GitHub",philosophyLabel:"Why only 3?",philosophyBody:"Skills are valuable only if you remember them and use them. We ship 3 tight workflows covering the decisions Etsy sellers make most often — launch, weekly scan, holiday plan — and won't add more without a clear signal from real use."},Ea={title:"Install YTrends MCP",subtitle:"Plug Etsy market research directly into your AI assistant. Free, public, rate-limited to 60 requests/minute per IP.",urlLabel:"MCP server URL",copyUrl:"Copy URL",whatIsTitle:"What is MCP?",whatIsBody:"Model Context Protocol (MCP) is an open standard that lets AI assistants call external tools. The YTrends MCP server exposes Etsy keyword research, trend scouting, hidden gems, and category analytics as 13 tools any MCP-aware client can use.",toolsTitle:"13 tools available",toolsSubtitle:"Every tool returns JSON your assistant can reason over. Names below match what the server exposes.",toolGroups:{keywords:"Keywords",listings:"Listings",market:"Market intelligence",discovery:"Discovery"},tools:{research_keyword:"Full keyword profile — demand, competition, price band, conversion, momentum, rank.",get_keyword_rank:"Just the global rank, tier, and rank history for a single keyword.",find_trending_keywords:"Keywords with strong recent sales and views momentum.",search:"Keyword search by substring or tag — quick discovery across the index.",find_hot_listings:"Breakout listings beating their niche on conversion or sales.",find_hidden_gems:"Underserved niches with high conversion and low competition.",browse_new_listings:"Newly created listings, filterable by niche.",browse_rankings:"Top-ranked, biggest movers, or newest keywords across the dataset.",market_snapshot:"Aggregate stats: total listings, sellers, revenue, price distribution, top categories.",analyze_competition:"Per-niche competition: seller concentration, price skew, top-seller share, structure.",explore_niche:"End-to-end niche brief combining demand, competition, pricing, and recommended action.",scout_opportunities:"Surface high-opportunity niches matching size, growth, or competition filters.",trend_calendar:"Seasonal events with prep windows, rank-lag, and Q4 deadlines."},ctaTitle:"Using Claude Code?",ctaBody:"Install the 3 YTrends skills to get pre-built market research workflows on top of these tools.",ctaLink:"Browse skills →"},Pa={new:"NEW",newKeyword:"New",tier:"Tier {tier}",dataFreshness:{fresh:"Fresh data",partial:"Partial data",stale:"Stale data"}},Aa={priceUnavailable:"Price unavailable in USD"},La={metadata:Or,nav:Vr,theme:Kr,home:$r,trending:Gr,rankings:Fr,keyword:Hr,sort:Ur,view:zr,table:Br,empty:Wr,stats:qr,competition:Yr,opportunityBadge:Xr,card:Qr,pagination:Zr,error:Jr,notFound:ea,auth:ta,trial:na,languageSwitcher:sa,marketPulse:ia,searchBar:ra,tooltips:aa,insights:oa,categories:la,hiddenGems:ca,hotListings:da,spy:ha